{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Powerfarm App Contract v0",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "powerfarm.specs/v0" },
    "kind": { "const": "AppContract" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generation", "subject", "owner"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/contractId" },
        "generation": { "type": "integer", "minimum": 1 },
        "subject": { "$ref": "common.schema.json#/$defs/entityId" },
        "owner": { "$ref": "common.schema.json#/$defs/entityId" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "maxLength": 1000 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "placement", "stateStores", "relationships", "lifecycle", "admission"],
      "properties": {
        "source": { "$ref": "common.schema.json#/$defs/sourceDescriptor" },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["place", "relativePath"],
          "properties": {
            "place": { "$ref": "common.schema.json#/$defs/entityId" },
            "relativePath": { "$ref": "common.schema.json#/$defs/relativePath" },
            "constraints": {
              "type": "object"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "entrypoint": { "type": "string", "minLength": 1 },
            "healthCapability": { "$ref": "common.schema.json#/$defs/entityId" },
            "environmentProfile": { "type": "string", "minLength": 1 }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "principal": { "$ref": "common.schema.json#/$defs/entityId" },
            "oauth": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required"],
              "properties": {
                "required": { "type": "boolean" },
                "profile": { "type": "string", "minLength": 1 },
                "clientId": { "type": "string", "minLength": 1 }
              }
            },
            "grantRefs": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" },
              "uniqueItems": true
            }
          }
        },
        "stateStores": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateStore" },
          "uniqueItems": true
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "produces": {
              "type": "array",
              "items": { "$ref": "#/$defs/contentClass" }
            },
            "consumes": {
              "type": "array",
              "items": { "$ref": "#/$defs/contentClass" }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provides": {
              "type": "array",
              "items": { "$ref": "#/$defs/capability" }
            },
            "consumes": {
              "type": "array",
              "items": { "$ref": "#/$defs/capability" }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desiredState"],
          "properties": {
            "desiredState": {
              "type": "string",
              "enum": ["active", "suspended", "retired"]
            },
            "supersedes": { "$ref": "common.schema.json#/$defs/contractRef" }
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirements"],
          "properties": {
            "requirements": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stateStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "engine", "purpose", "locator", "schema", "authoritativeFor", "durability", "searchable", "sensitivity"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/entityId" },
        "engine": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath"],
          "properties": {
            "place": { "$ref": "common.schema.json#/$defs/entityId" },
            "relativePath": { "$ref": "common.schema.json#/$defs/relativePath" }
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                { "type": "integer", "minimum": 0 }
              ]
            },
            "content": { "$ref": "common.schema.json#/$defs/contentRef" },
            "artifact": { "$ref": "common.schema.json#/$defs/artifactVersionRef" },
            "migrationDigest": { "$ref": "common.schema.json#/$defs/digest" },
            "genesisDigest": { "$ref": "common.schema.json#/$defs/digest" }
          },
          "anyOf": [
            { "required": ["content"] },
            { "required": ["artifact"] },
            { "required": ["migrationDigest"] }
          ]
        },
        "authoritativeFor": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "durability": {
          "type": "string",
          "enum": ["ephemeral", "local-durable", "replicated", "external-durable"]
        },
        "snapshotPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["none", "manual", "periodic", "on-change"]
            },
            "interval": { "$ref": "common.schema.json#/$defs/duration" }
          }
        },
        "searchable": { "type": "boolean" },
        "sensitivity": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "migrationAuthority": { "$ref": "common.schema.json#/$defs/entityId" }
      }
    },
    "contentClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mediaType"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "mediaType": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^\\s]+$"
        },
        "schema": { "$ref": "common.schema.json#/$defs/artifactVersionRef" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interface"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/entityId" },
        "interface": { "$ref": "common.schema.json#/$defs/capabilityInterface" },
        "profile": { "$ref": "common.schema.json#/$defs/artifactVersionRef" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["antenna", "heartime", "executability", "search", "other"]
        },
        "required": { "type": "boolean", "default": true },
        "contract": { "$ref": "common.schema.json#/$defs/contractRef" }
      }
    }
  }
}
